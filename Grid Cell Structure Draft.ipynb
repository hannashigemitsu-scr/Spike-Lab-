    "# -----------------------------------------------------------------------\n",
    "# Cell 1 - Configurations (settings) for RNN model\n",
    "# -----------------------------------------------------------------------\n",
    "\n",
    "\n",
    "def set_seed(seed: int) -> None:\n",
    "    \"\"\"Seed python, numpy and torch so a run can be repeated exactly.\"\"\"\n",
    "    random.seed(seed)\n",
    "    np.random.seed(seed)\n",
    "    torch.manual_seed(seed)\n",
    "\n",
    "\n",
    "@dataclass\n",
    "class SpaceConfig:\n",
    "    \"\"\"The 'conceptual space': a bounded 2D square whose axes are factors A and B.\n",
    "\n",
    "    In the physical-space version of the task A and B would be x and y.\n",
    "    Here they are abstract factors; the math is identical.\n",
    "    \"\"\"\n",
    "    arena_size: float = 16.0       # side length; coordinates run -8..+8 (16 x 16 arena,\n",
    "                                   # project spec)\n",
    "    max_speed: float = 1.5         # per-step step size upper bound. The paper's speeds run\n",
    "                                   # 0..0.2 in a ~2.2-wide arena (~9% of the width per step);\n",
    "                                   # 1.5 keeps that ratio for a 16-wide arena (my scaling)\n",
    "    heading_noise_std: float = 0.3 # radians; per-step heading wobble. Small value\n",
    "                                   # = long straight runs (\"modified Brownian\n",
    "                                   # motion\" in the paper). Exact value: my choice\n",
    "    zero_speed_frac: float = 0.9   # fraction of steps where the animal does NOT move\n",
    "                                   # and speed input is 0. Paper: \"e.g. 90%\" and says\n",
    "                                   # it is crucial for grid-like units (project spec: 0.9)\n",
    "    wall_margin: float = 1.5       # within this distance of a wall, a heading that points\n",
    "                                   # INTO the wall is reflected away from it, so the velocity\n",
    "                                   # sequence itself never leaves the arena. Must be\n",
    "                                   # >= max_speed for that to be guaranteed (my choice)\n",
    "    start_mode: str = \"random\"     # \"random\": start anywhere in the arena; the start\n",
    "                                   #   position is given as input at t = 0 only.\n",
    "                                   # \"center\": always start at (0, 0) (old behaviour;\n",
    "                                   #   the start-position input is then always 0)\n",
    "    input_mode: str = \"speed_cossin\"\n",
    "\n",
    "\n",
    "@dataclass\n",
    "class RNNConfig:\n",
    "    n_hidden: int = 512            # paper: N = 100 recurrent units; project spec: 512\n",
    "    alpha: float = 0.1             # Euler step / time constant (paper: step = tau/10)\n",
    "    noise_std: float = 0.05        # recurrent noise. Paper: \"constant variance\", value\n",
    "                                   # not important. Magnitude here: my choice\n",
    "    expansion_dim: int = 0         # 0 = off (Cueva & Wei). >0 adds a FIXED random\n",
    "                                   # ReLU expansion layer in front of the RNN\n",
    "                                   # (Fascianelli). Off for the replication.\n",
    "    rec_init: str = \"orthogonal\"   # paper: orthogonal (square/triangle) or Gaussian\n",
    "                                   # with variance 1.5^2/N (hexagon)\n",
    "    rec_init_gain: float = 1.0\n",
    "\n",
    "\n",
    "@dataclass\n",
    "class GridTrainConfig:\n",
    "    seq_len: int = 100             # 100 velocity inputs per trajectory (project spec;\n",
    "                                   # paper: T = 500)\n",
    "    batch_size: int = 128          # paper: 500 (Hessian-free). Smaller for CPU\n",
    "    n_steps: int = 5000            # number of optimizer steps (my choice)\n",
    "    lr: float = 1e-3               # Adam. The paper used Hessian-free optimization,\n",
    "                                   # which is NOT available in PyTorch. Swapping the\n",
    "                                   # optimizer is an untested change; if grid cells do\n",
    "                                   # not appear, optimizer and regularization strength\n",
    "                                   # are the first suspects.\n",
    "    grad_clip: float = 1.0\n",
    "    l2_weight: float = 1e-4        # L2 weight penalty: mean squared weight, summed over the\n",
    "                                   # matrices in l2_targets. Value: my choice\n",
    "    l2_targets: tuple = (\"W_in\", \"W_rec\", \"W_out\")\n",
    "                                   # paper eq. 4 penalizes W_in and W_out; the project spec\n",
    "                                   # also penalizes the recurrent weights between units\n",
    "    rate_penalty: str = \"l1\"       # \"l1\": mean |firing rate| per unit per time step (project\n",
    "                                   # spec); \"l2\": mean squared rate (the paper's form)\n",
    "    fr_ratio: float = 0.1          # firing-rate (\"metabolic\") penalty is scaled so that\n",
    "                                   # penalty ~= fr_ratio * position error. Paper keeps it\n",
    "                                   # between error/10 and error/3. THIS IS THE MOST\n",
    "                                   # IMPORTANT KNOB FOR GRID EMERGENCE (paper sec 3.2).\n",
    "    log_every: int = 100\n",
    "\n",
    "\n",
    "@dataclass\n",
    "class GridAnalysisConfig:\n",
    "    n_eval_traj: int = 1000        # trajectories used to build rate maps. Random starts\n",
    "                                   # spread these over the whole arena\n",
    "    eval_seq_len: int = 100        # same as training, so the network is not asked to\n",
    "                                   # integrate for longer than it learned to\n",
    "    eval_zero_frac: float = None   # fraction of 'standing still' steps at EVALUATION.\n",
    "                                   # None = use the training value (safest; see README).\n",
    "                                   # A lower value explores more but changes the input\n",
    "                                   # statistics the network was trained on.\n",
    "    n_bins: int = 20               # rate-map resolution (n_bins x n_bins)\n",
    "    smooth_sigma: float = 1.0      # Gaussian smoothing of rate maps, in bins"
   ]
