    "## Code part D: analysis tools\n",
    "Rate maps, spatial autocorrelation, gridness scores, shuffle null, and how linear the population code is."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "da86176e",
   "metadata": {},
   "outputs": [],
   "source": [
    "# -----------------------------------------------------------------------\n",
    "# Analysis of resulting griddiness \n",
    "# need to add Shattering Dimensionality and Cross Condition Generalization Performance\n",
    "# -----------------------------------------------------------------------\n",
    "\n",
    "\n",
    "def compute_rate_maps(rates, pos, arena_size, n_bins=20, smooth_sigma=1.0):\n",
    "    \"\"\"\n",
    "    Average each unit's firing rate in every spatial bin.\n",
    "\n",
    "    Input : rates (N_traj, T, H)   firing rates from the RNN\n",
    "            pos   (N_traj, T, 2)   true position at the same time steps\n",
    "    Output: maps (H, n_bins, n_bins), axes = [A bin, B bin]; np.nan where the\n",
    "            animal never visited. Maps are lightly smoothed.\n",
    "    \"\"\"\n",
    "    H = rates.shape[-1]\n",
    "    half = arena_size / 2.0\n",
    "    p = pos.reshape(-1, 2)\n",
    "    r = rates.reshape(-1, H)\n",
    "    idx = np.floor((p + half) / arena_size * n_bins).astype(int)\n",
    "    idx = np.clip(idx, 0, n_bins - 1)\n",
    "    lin = idx[:, 0] * n_bins + idx[:, 1]\n",
    "\n",
    "    counts = np.bincount(lin, minlength=n_bins * n_bins).astype(float)\n",
    "    visited = counts > 0\n",
    "    maps = np.full((H, n_bins * n_bins), np.nan)\n",
    "    c_s = gaussian_filter(counts.reshape(n_bins, n_bins), smooth_sigma)\n",
    "    for h in range(H):\n",
    "        sums = np.bincount(lin, weights=r[:, h], minlength=n_bins * n_bins)\n",
    "        s_s = gaussian_filter(sums.reshape(n_bins, n_bins), smooth_sigma)\n",
    "        m = np.where(c_s > 1e-9, s_s / np.maximum(c_s, 1e-9), np.nan).ravel()\n",
    "        m[~visited] = np.nan\n",
    "        maps[h] = m\n",
    "    return maps.reshape(H, n_bins, n_bins)\n",
    "\n",
    "\n",
    "def _xcorr(a, b):\n",
    "    \"\"\"R_ab(s) = sum_i a[i] * b[i+s], all 2D shifts s, via FFT.\"\"\"\n",
    "    return fftconvolve(b, a[::-1, ::-1], mode=\"full\")\n",
    "\n",
    "\n",
    "def spatial_autocorr(rm, min_overlap=20):\n",
    "    \"\"\"\n",
    "    Pearson autocorrelation of a rate map with itself at every 2D shift,\n",
    "    computed only over bins that are valid (visited) in BOTH shifted copies.\n",
    "    Output is (2n-1, 2n-1) with the zero-shift peak at the center.\n",
    "    \"\"\"\n",
    "    M = np.isfinite(rm).astype(float)\n",
    "    m = np.where(M > 0, rm, 0.0)\n",
    "    n = _xcorr(M, M)\n",
    "    sx, sy = _xcorr(m, M), _xcorr(M, m)\n",
    "    sxy = _xcorr(m, m)\n",
    "    sxx, syy = _xcorr(m * m, M), _xcorr(M, m * m)\n",
    "    num = n * sxy - sx * sy\n",
    "    den = np.sqrt(np.maximum((n * sxx - sx ** 2) * (n * syy - sy ** 2), 0))\n",
    "    ac = np.where((n >= min_overlap) & (den > 1e-12), num / np.maximum(den, 1e-12), 0.0)\n",
    "    return ac\n",
    "\n",
    "\n",
    "def gridness_scores(ac, max_frac=0.8):\n",
    "    \"\"\"\n",
    "    Standard gridness idea (Sargolini-style): if a map is a hexagonal lattice, its\n",
    "    autocorrelation looks the same when rotated by 60 and 120 degrees but NOT by\n",
    "    30, 90, 150.  Score = min(r60, r120) - max(r30, r90, r150).\n",
    "    Square lattices (expected in a square arena per Cueva & Wei) repeat every 90\n",
    "    degrees, so I also return a square score = r90 - max(r45, r135).\n",
    "\n",
    "    Caveats (important):\n",
    "      * Cueva & Wei's units show only a FEW periods, so these scores are noisy.\n",
    "      * The square score is UNCALIBRATED: in my tests it averages ~0.3 on smoothed\n",
    "        random noise. Never use a fixed threshold; compare against the shuffle\n",
    "        null (shuffle_null_gridness below).\n",
    "    Input : ac (2n-1, 2n-1) from spatial_autocorr\n",
    "    Output: dict(hex=..., square=...), nan if the map is too weak to score.\n",
    "    \"\"\"\n",
    "    c = (ac.shape[0] - 1) // 2\n",
    "    yy, xx = np.indices(ac.shape)\n",
    "    rr = np.hypot(yy - c, xx - c)\n",
    "\n",
    "    # radial mean profile -> find where the central peak ends (first r where <= 0)\n",
    "    prof = np.array([ac[(rr >= r - 0.5) & (rr < r + 0.5)].mean() for r in range(1, c)])\n",
    "    below = np.flatnonzero(prof <= 0)\n",
    "    if len(below) == 0:\n",
    "        return {\"hex\": np.nan, \"square\": np.nan}\n",
    "    r_in = int(below[0]) + 1\n",
    "\n",
    "    angles = [30, 45, 60, 90, 120, 135, 150]\n",
    "    rot = {a: rotate(ac, a, reshape=False, order=1, mode=\"constant\", cval=0.0) for a in angles}\n",
    "\n",
    "    best_hex, best_sq = -np.inf, -np.inf\n",
    "    for r_out in range(r_in + 3, int(max_frac * c) + 1):\n",
    "        mask = (rr > r_in) & (rr <= r_out)\n",
    "        if mask.sum() < 10:\n",
    "            continue\n",
    "\n",
    "        def corr(a):\n",
    "            v = np.corrcoef(ac[mask], rot[a][mask])[0, 1]\n",
    "            return v if np.isfinite(v) else np.nan\n",
    "\n",
    "        r = {a: corr(a) for a in angles}\n",
    "        if any(np.isnan(v) for v in r.values()):\n",
    "            continue\n",
    "        best_hex = max(best_hex, min(r[60], r[120]) - max(r[30], r[90], r[150]))\n",
    "        best_sq = max(best_sq, r[90] - max(r[45], r[135]))\n",
    "    if not np.isfinite(best_hex):\n",
    "        return {\"hex\": np.nan, \"square\": np.nan}\n",
    "    return {\"hex\": float(best_hex), \"square\": float(best_sq)}\n",
    "\n",
    "\n",
    "def score_all_units(maps):\n",
    "    \"\"\"gridness_scores for every unit's rate map. Returns (H, 2): columns hex, square.\n",
    "    Silent/constant or barely-visited units get nan.\"\"\"\n",
    "    H = maps.shape[0]\n",
    "    out = np.full((H, 2), np.nan)\n",
    "    for h in range(H):\n",
    "        if np.isfinite(maps[h]).sum() < 50 or np.nanstd(maps[h]) < 1e-6:\n",
    "            continue\n",
    "        s = gridness_scores(spatial_autocorr(maps[h]))\n",
    "        out[h] = (s[\"hex\"], s[\"square\"])\n",
    "    return out\n",
    "\n",
    "\n",
    "def shuffle_null_gridness(rates, pos, arena_size, n_bins, smooth_sigma, rng, n_shuffles=20):\n",
    "    \"\"\"\n",
    "    Null distribution for gridness. For each shuffle, every trajectory's activity\n",
    "    is circularly shifted in time by a random offset relative to its position (this\n",
    "    breaks the link between activity and place but keeps each unit's activity\n",
    "    statistics), then rate maps and scores are recomputed.\n",
    "\n",
    "    Input : rates (N,T,H), pos (N,T,2)\n",
    "    Output: array (n_shuffles, H, 2)   (last axis: hex, square)\n",
    "\n",
    "    WHY THIS IS NEEDED: my square score is biased upward on pure smoothed noise\n",
    "    (mean ~0.3, 95th percentile ~1.0 in my tests), so a raw threshold like \"> 0.3\"\n",
    "    would give false positives. The hex score is better behaved (95th pct ~0.57)\n",
    "    but still needs a null. Pool the output over units and shuffles and take, e.g.,\n",
    "    the 95th percentile of each column as the threshold.\n",
    "    \"\"\"\n",
    "    N, T, H = rates.shape\n",
    "    out = np.full((n_shuffles, H, 2), np.nan)\n",
    "    for k in range(n_shuffles):\n",
    "        offs = rng.integers(T // 4, 3 * T // 4, size=N)\n",
    "        shuf = np.stack([np.roll(rates[i], offs[i], axis=0) for i in range(N)])\n",
    "        maps = compute_rate_maps(shuf, pos, arena_size, n_bins, smooth_sigma)\n",
    "        out[k] = score_all_units(maps)\n",
    "    return out"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "747b55c8",
   "metadata": {},
   "outputs": [],
   "source": [
    "def participation_ratio(reps):\n",
    "    \"\"\"PR = (sum eig)^2 / sum(eig^2) of the covariance of reps. ~ #dimensions used.\"\"\"\n",
    "    c = np.cov(reps - reps.mean(0), rowvar=False)\n",
    "    return float(np.trace(c) ** 2 / (c ** 2).sum())\n",
    "\n",
    "\n",
    "def _fit_eval_clf(Xtr, ytr, Xte, yte):\n",
    "    sc = StandardScaler().fit(Xtr)\n",
    "    clf = LogisticRegression(max_iter=2000).fit(sc.transform(Xtr), ytr)\n",
    "    return clf.score(sc.transform(Xte), yte)\n",
    "\n",
    "\n",
    "def _fit_eval_reg(Xtr, Ytr, Xte, Yte, alpha=1.0):\n",
    "    sc = StandardScaler().fit(Xtr)\n",
    "    reg = Ridge(alpha=alpha).fit(sc.transform(Xtr), Ytr)\n",
    "    pred = reg.predict(sc.transform(Xte))\n",
    "    # r^2 pooled over latent dimensions; 0 = predict the mean, can be negative\n",
    "    return 1.0 - ((Yte - pred) ** 2).sum() / ((Yte - Yte.mean(0)) ** 2).sum()\n",
    "\n",
    "\n",
    "def axis_split_generalization(reps, latents):\n",
    "    \"\"\"\n",
    "    A literal 2-factor CCGP for points laid out on a grid of positions (e.g. the\n",
    "    RNN's rate maps flattened to (bins^2, units) with latents = (A, B)).\n",
    "\n",
    "    For each split axis s in {A, B}:\n",
    "      classifier : learn \"is factor (1-s) positive?\" using only points with\n",
    "                   factor s < 0, test on points with factor s > 0 (and swap).\n",
    "                   => does the decoder for A transfer across levels of B?  (CCGP)\n",
    "      regression : learn to read out BOTH coordinates on one side, test on the other.\n",
    "    Returns dict with averaged clf accuracy and reg r^2 (chance 0.5 and 0).\n",
    "    \"\"\"\n",
    "    accs, r2s = [], []\n",
    "    for s in (0, 1):\n",
    "        other = 1 - s\n",
    "        y = (latents[:, other] > 0).astype(int)\n",
    "        neg, pos = latents[:, s] < 0, latents[:, s] > 0\n",
    "        for tr, te in ((neg, pos), (pos, neg)):\n",
    "            accs.append(_fit_eval_clf(reps[tr], y[tr], reps[te], y[te]))\n",
    "            r2s.append(_fit_eval_reg(reps[tr], latents[tr], reps[te], latents[te]))\n",
    "    return {\"clf_acc\": float(np.mean(accs)), \"reg_r2\": float(np.mean(r2s))}"
   ]
  },
