    "## Code part C: the leaky RNN (Cueva & Wei eq. 1-2)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "6afc4ac4",
   "metadata": {},
   "outputs": [],
   "source": [
    "# -----------------------------------------------------------------------\n",
    "# Model class (leaky RNN)\n",
    "# -----------------------------------------------------------------------\n",
    "\n",
    "class PathIntegratorRNN(nn.Module):\n",
    "    \"\"\"\n",
    "    Each time step (see Cueva & Wei eq. 1-2, discretized with Euler):\n",
    "\n",
    "        u_t   = tanh(x_{t-1})                         # firing rates\n",
    "        drive = W_rec u_t + W_in I_t + b + noise      # what each unit receives\n",
    "        x_t   = (1 - alpha) * x_{t-1} + alpha * drive # leaky update; alpha = dt/tau\n",
    "        y_t   = W_out tanh(x_t)                       # position readout (NO bias)\n",
    "\n",
    "    Plain-language version: each unit holds a \"memory\" x that slowly leaks away\n",
    "    and slowly absorbs new input. Its visible firing rate is tanh of that memory.\n",
    "    The position readout is just a weighted sum of firing rates.\n",
    "\n",
    "    Leak: alpha = 0.1, i.e. each step a unit keeps 90% of its old state and takes\n",
    "    in 10% of its new drive.\n",
    "\n",
    "    Initial state is zero and the readout has no bias. The start position arrives\n",
    "    as input at t = 0 (see space.py), so the network has to store it in its own\n",
    "    activity and update it from the speed/heading inputs after that.\n",
    "\n",
    "    OPTIONAL Fascianelli lever (expansion_dim > 0): the raw input first passes\n",
    "    through a FIXED, untrained random ReLU layer. This controls how much of the\n",
    "    input's structure the network inherits. Off for the Cueva & Wei replication.\n",
    "\n",
    "    Inputs\n",
    "    ------\n",
    "    inputs : (batch, T, n_in)   [start position (t = 0 only), step features]\n",
    "                                from space.py\n",
    "    noise  : bool               add recurrent noise (True in training; analysis\n",
    "                                usually uses False for clean rate maps)\n",
    "    Returns\n",
    "    -------\n",
    "    outputs : (batch, T, 2)     predicted position after each step\n",
    "    rates   : (batch, T, n_hidden)  firing rates u_t (what we analyze later)\n",
    "    \"\"\"\n",
    "\n",
    "    def __init__(self, n_in, n_hidden=512, n_out=2, alpha=0.1, noise_std=0.05,\n",
    "                 expansion_dim=0, rec_init=\"orthogonal\", rec_init_gain=1.0):\n",
    "        super().__init__()\n",
    "        self.n_hidden, self.alpha, self.noise_std = n_hidden, alpha, noise_std\n",
    "\n",
    "        # optional fixed random expansion (frozen: requires_grad=False)\n",
    "        self.expansion_dim = expansion_dim\n",
    "        if expansion_dim > 0:\n",
    "            self.expand = nn.Linear(n_in, expansion_dim, bias=False)\n",
    "            nn.init.normal_(self.expand.weight, std=1.0 / math.sqrt(n_in))\n",
    "            self.expand.weight.requires_grad_(False)\n",
    "            n_in = expansion_dim\n",
    "\n",
    "        self.W_in = nn.Linear(n_in, n_hidden, bias=False)\n",
    "        self.W_rec = nn.Linear(n_hidden, n_hidden, bias=False)\n",
    "        self.b = nn.Parameter(torch.zeros(n_hidden))\n",
    "        self.W_out = nn.Linear(n_hidden, n_out, bias=False)\n",
    "\n",
    "        # --- initialization, following the paper where it says ---\n",
    "        nn.init.normal_(self.W_in.weight, std=1.0 / math.sqrt(n_in))   # var 1/N_in\n",
    "        if rec_init == \"orthogonal\":\n",
    "            nn.init.orthogonal_(self.W_rec.weight, gain=rec_init_gain)\n",
    "        else:                                                          # Gaussian\n",
    "            nn.init.normal_(self.W_rec.weight, std=rec_init_gain / math.sqrt(n_hidden))\n",
    "        nn.init.zeros_(self.W_out.weight)                              # paper: zeros\n",
    "\n",
    "    def forward(self, inputs, noise=True):\n",
    "        B, T, _ = inputs.shape\n",
    "        if self.expansion_dim > 0:\n",
    "            inputs = F.relu(self.expand(inputs))       # fixed random features\n",
    "\n",
    "        x = inputs.new_zeros(B, self.n_hidden)         # initial state = 0\n",
    "        outs, rates = [], []\n",
    "        for t in range(T):\n",
    "            u = torch.tanh(x)\n",
    "            drive = self.W_rec(u) + self.W_in(inputs[:, t]) + self.b\n",
    "            if noise and self.noise_std > 0:\n",
    "                drive = drive + self.noise_std * torch.randn_like(drive)\n",
    "            x = (1 - self.alpha) * x + self.alpha * drive\n",
    "            u_new = torch.tanh(x)\n",
    "            outs.append(self.W_out(u_new))\n",
    "            rates.append(u_new)\n",
    "        return torch.stack(outs, dim=1), torch.stack(rates, dim=1)"
   ]
